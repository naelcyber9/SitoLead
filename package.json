{
  "name": "sitolead",
  "version": "1.0.0",
  "private": true,
  "description": "Vous créez des sites, on vous trouve les clients : prospection d'entreprises sans site ou avec un site faible.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "seed": "node src/cli/seed.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "leaflet": "1.9.4",
    "zod": "^4.6.7"
  }
}
