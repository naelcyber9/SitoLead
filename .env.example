# Copier en .env (jamais commité).

# URL publique (sert aux liens Stripe, au sitemap et aux balises canoniques).
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1

# Stripe : clé secrète (sk_test_... en test) et secret du webhook (whsec_...).
# Webhook à créer sur  APP_URL/api/stripe/webhook  avec les événements :
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel : identifiants de prix créés dans Stripe. Sans eux, le prix est
# défini directement dans la session Checkout (29 € et 79 € / mois).
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

# Identité légale affichée dans les mentions légales.
LEGAL_NAME=Sitolead
LEGAL_CONTACT=contact@exemple.fr

# 0 pour désactiver les appels aux sources en ligne (OpenStreetMap, SIRENE).
LIVE_SOURCES=1

# OpenStreetMap (Overpass). Vide = instances publiques gratuites, à usage MODÉRÉ
# uniquement (développement, petit trafic). En production : votre propre instance
# (voir docs/DEPLOIEMENT.md). Plusieurs adresses possibles, séparées par des virgules.
OVERPASS_URL=

# Préchargement en tâche de fond des 30 grandes villes et des communes demandées par
# les recherches de zone (département, région, rayon). 0 pour le désactiver.
WARM_CACHE=1

# Fond de carte. Vide = tuiles OpenStreetMap standard (développement / faible trafic
# seulement, attribution obligatoire). En production : un fournisseur de tuiles.
MAP_TILE_URL=
MAP_ATTRIBUTION=

# Derrière un proxy (Nginx, Caddy, hébergeur) : 1 pour lire l'IP réelle dans X-Forwarded-For
# (limitation des tentatives de connexion et des inscriptions).
TRUST_PROXY=0
# Sel du hachage des adresses IP enregistrées à l'inscription (valeur aléatoire, gardée secrète).
IP_SALT=

# Rédaction des textes de maquettes par l'IA (Claude). Vide = fonction désactivée.
# Clé à créer sur console.anthropic.com (facturée sur votre crédit Anthropic).
ANTHROPIC_API_KEY=
# Plafond de dépense IA par jour pour tout le serveur, en dollars (2 $ ≈ 90 rédactions).
AI_DAILY_BUDGET_USD=2
# Modèle utilisé (par défaut claude-opus-5-5).
AI_MODEL=

# Dossier des images envoyées pour les maquettes (logo, photo). À sauvegarder avec la base.
UPLOAD_DIR=data/uploads
