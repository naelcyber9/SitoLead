# Copier en .env (jamais commité).

# URL publique (sert aux liens Stripe, au sitemap et aux balises canoniques).
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1

# Stripe : clé secrète (sk_test_... en test) et secret du webhook (whsec_...).
# Webhook à créer sur  APP_URL/api/stripe/webhook  avec les événements :
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel : identifiants de prix créés dans Stripe. Sans eux, le prix est
# défini directement dans la session Checkout (29 € et 79 € / mois).
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

# Identité légale affichée dans les mentions légales.
LEGAL_NAME=Sitolead
LEGAL_CONTACT=contact@exemple.fr

# 0 pour désactiver les appels aux sources en ligne (OpenStreetMap, SIRENE).
LIVE_SOURCES=1
